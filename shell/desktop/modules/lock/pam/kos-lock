# PAM service for the Kos shell lock screen.
#
# Deliberately self-contained instead of pointing at /etc/pam.d/*. The shell is
# a user process and cannot write there, and borrowing another package's
# service file (swaylock's, for instance) would make that package a silent
# runtime dependency of the lock screen.
#
# PamContext reads this directory in place of /etc/pam.d through
# pam_start_confdir(), so nothing has to be installed as root.
#
# pam_unix authenticates through unix_chkpwd, which is setuid root, so a
# non-root process can verify a password without ever opening /etc/shadow.
# No pam_faildelay here on purpose: a lock screen should report a wrong
# password immediately rather than make the user wait out a deliberate delay.

auth      required   pam_unix.so
